{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": ["vite/client"],
        "strictPropertyInitialization": false,
        "paths": {
            "@game/*": ["./src/endless-runner/*"]
        }
    },
    "include": ["src/**/*"]
}
